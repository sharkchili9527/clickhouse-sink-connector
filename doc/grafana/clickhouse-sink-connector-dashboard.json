      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 64 },
      "id": 34,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }, "expr": "sum by (name) (increase(debezium_metrics_NumberOfErroneousEvents{context=\"streaming\"}[5m]))", "legendFormat": "{{name}}" } ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never" }, "color": { "mode": "fixed", "fixedColor": "red" }, "noValue": "无源端指标数据" }, "overrides": [] }
    }
