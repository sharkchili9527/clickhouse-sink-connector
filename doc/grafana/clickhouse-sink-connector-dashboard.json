      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5000 }, { "color": "red", "value": 30000 } ] }, "noValue": "无源端指标数据" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "距上次事件 (ms) 趋势",
      "description": "debezium_metrics_MilliSecondsSinceLastEvent 时间序列。锯齿抬升后回落=正常；单调爬升不回落=停滞。",
