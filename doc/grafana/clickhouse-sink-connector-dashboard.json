      "description": "rate(debezium_metrics_TotalNumberOfEventsSeen[5m])。源端每秒读到的 binlog 事件数。不受写入冻结影响：Connected=1 但此值长期为 0 = 连着却没事件(源库空闲 或 上游 binlog 异常)。",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 64 },
      "id": 33,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }, "expr": "sum by (name) (rate(debezium_metrics_TotalNumberOfEventsSeen{context=\"streaming\"}[5m]))", "legendFormat": "{{name}}" } ],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" }, "noValue": "无源端指标数据" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "源端错误事件 (increase)",
