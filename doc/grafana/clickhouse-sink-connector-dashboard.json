      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 56 },
      "id": 31,
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROM}" }, "expr": "sum by (name) (increase(debezium_metrics_NumberOfDisconnects{context=\"streaming\"}[5m]))", "legendFormat": "{{name}}" } ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "showPoints": "never" }, "color": { "mode": "fixed", "fixedColor": "orange" }, "noValue": "无源端指标数据" }, "overrides": [] }
    },
    {
      "type": "row",
      "title": "源端事件流与错误 (源端指标)",
